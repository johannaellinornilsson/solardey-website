/assets/*.mp4
  Content-Type: video/mp4

/assets/images/*.mp4
  Content-Type: video/mp4

/assets/*.webm
  Content-Type: video/webm

/assets/svg/*.svg
  Content-Type: image/svg+xml

/assets/images/*.svg
  Content-Type: image/svg+xml

/assets/*.vcf
  Content-Type: text/vcard; charset=utf-8
  Content-Disposition: inline; filename="prosper-emegoakor.vcf"

# ── Caching ──
# Images, video and fonts rarely change: cache for 30 days.
/assets/*
  Cache-Control: public, max-age=2592000

# CSS/JS have no hashed filenames: cache 1 day, revalidate in the background.
/css/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/js/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/llms.txt
  Content-Type: text/plain; charset=utf-8
